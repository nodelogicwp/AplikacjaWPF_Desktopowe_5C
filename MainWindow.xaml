<Window x:Class="Menadrzerzadan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Formularz użytkownika"
        Height="650" Width="500"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="65"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="55"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="2"
                   Text="Formularz użytkownika"
                   FontSize="26"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <Label Grid.Row="1" Grid.Column="0"
               Content="Imię:" VerticalAlignment="Center"/>
        <TextBox x:Name="ImieTextBox"
                 Grid.Row="1" Grid.Column="1"
                 Margin="5" VerticalContentAlignment="Center"/>

        <Label Grid.Row="2" Grid.Column="0"
               Content="Nazwisko:" VerticalAlignment="Center"/>
        <TextBox x:Name="NazwiskoTextBox"
                 Grid.Row="2" Grid.Column="1"
                 Margin="5" VerticalContentAlignment="Center"/>

        <Label Grid.Row="3" Grid.Column="0"
               Content="Wiek:" VerticalAlignment="Center"/>
        <TextBox x:Name="WiekTextBox"
                 Grid.Row="3" Grid.Column="1"
                 Margin="5" VerticalContentAlignment="Center"/>

        <Label Grid.Row="4" Grid.Column="0"
               Content="Płeć:" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="4" Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <RadioButton x:Name="MezczyznaRadioButton"
                         Content="Mężczyzna"
                         GroupName="Plec"
                         Margin="5"
                         VerticalAlignment="Center"/>

            <RadioButton x:Name="KobietaRadioButton"
                         Content="Kobieta"
                         GroupName="Plec"
                         Margin="5"
                         VerticalAlignment="Center"/>
        </StackPanel>

        <Label Grid.Row="5" Grid.Column="0"
               Content="Data urodzenia:"
               VerticalAlignment="Center"/>

        <DatePicker x:Name="DataUrodzeniaPicker"
                    Grid.Row="5" Grid.Column="1"
                    Margin="5"
                    VerticalAlignment="Center"/>

        <Label Grid.Row="6" Grid.Column="0"
               Content="Dodatkowe&#10;informacje:"
               VerticalAlignment="Top"
               Padding="5"/>

        <TextBox x:Name="InformacjeTextBox"
                 Grid.Row="6" Grid.Column="1"
                 Margin="5"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"/>

        <Button x:Name="WyslijButton"
                Grid.Row="7" Grid.Column="1"
                Content="Wyślij"
                Width="120" Height="35"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="DodgerBlue"
                Foreground="White"
                FontWeight="Bold"
                Click="WyslijButton_Click"/>
    </Grid>
</Window>
